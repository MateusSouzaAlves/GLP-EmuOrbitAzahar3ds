<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="4dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:centerColor="#70101010"
                android:centerY="0.48" android:endColor="#85000000"
                android:startColor="#5C3A3A3A" android:type="linear" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:centerColor="#0CFFFFFF"
                android:centerY="0.34" android:endColor="#00FFFFFF"
                android:startColor="#30FFFFFF" android:type="linear" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
