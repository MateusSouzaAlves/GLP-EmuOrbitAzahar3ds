<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:centerColor="#8A111111"
                android:endColor="#99000000" android:startColor="#80404040"
                android:type="linear" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="#BFFFFFFF" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
